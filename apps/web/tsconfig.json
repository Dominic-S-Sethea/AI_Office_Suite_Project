{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ai-office-suite/shared-contracts": ["../../packages/shared-contracts/src/index.ts"],
      "@ai-office-suite/document-engine/tiptap-codec": ["../../engines/document/src/tiptapCodec.ts"]
    }
  },
  "include": ["src"]
}
