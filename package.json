{
  "name": "ai-office-suite",
  "version": "0.1.0-d1",
  "description": "AI Office Suite — Modular AI-native corporate productivity platform (Phase D0/D1 Feasibility Prototype)",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "platform/*",
    "engines/*",
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p apps/api/tsconfig.build.json",
    "build:web": "npm run build --workspace=@ai-office-suite/web",
    "test": "vitest run",
    "lint:licenses": "node scripts/check-licenses.mjs",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace=@ai-office-suite/web",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "@electric-sql/pglite": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.9.0",
    "nodejs-polars": "0.26.2",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "image-size": "^2.1.0"
  }
}
