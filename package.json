{
  "name": "ai-office-suite",
  "version": "0.1.0-d1",
  "description": "AI Office Suite — Modular AI-native corporate productivity platform (Phase D0/D1 Feasibility Prototype)",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "platform/*",
    "engines/*",
    "modules/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "build": "npm run build:api && npm run build:workers && npm run build:web",
    "build:api": "tsc -p apps/api/tsconfig.build.json",
    "build:workers": "tsc -p apps/workers/tsconfig.build.json",
    "build:web": "npm run build --workspace=@ai-office-suite/web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:licenses": "node scripts/check-licenses.mjs",
    "lint:hygiene": "node scripts/check-hygiene.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "bench:check": "node scripts/bench-check.mjs",
    "db:migrate": "node scripts/db-cli.mjs migrate",
    "db:verify-rls": "node scripts/db-cli.mjs verify-rls",
    "db:backup": "node scripts/db-cli.mjs backup",
    "db:restore": "node scripts/db-cli.mjs restore",
    "db:seed-dev": "node scripts/db-cli.mjs seed-dev",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace=@ai-office-suite/web",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "fflate": "^0.8.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "image-size": "^2.1.0"
  }
}
