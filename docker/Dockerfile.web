# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build

WORKDIR /app

# Copy workspace manifests first so Docker caches `npm ci` across frontend source edits (H29)
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared-contracts/package.json packages/shared-contracts/
COPY engines/document/package.json engines/document/
COPY apps/web/package.json apps/web/

RUN npm ci --workspace=@ai-office-suite/web --include-workspace-root --no-audit --no-fund

# Copy only the source workspaces required to compile apps/web
COPY packages/shared-contracts ./packages/shared-contracts
COPY engines/document ./engines/document
COPY apps/web ./apps/web

RUN npm run build:web

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1
