# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS deps

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared-contracts/package.json packages/shared-contracts/
COPY packages/validation/package.json packages/validation/
COPY platform/audit/package.json platform/audit/
COPY platform/authorization/package.json platform/authorization/
COPY engines/calculation/package.json engines/calculation/
COPY engines/data-processing/package.json engines/data-processing/
COPY engines/document/package.json engines/document/
COPY engines/file-conversion/package.json engines/file-conversion/
COPY engines/presentation/package.json engines/presentation/
COPY apps/workers/package.json apps/workers/

# Install ONLY production runtime dependencies for the isolated OOXML & PDF worker process
# (excludes database/pg, identity, web UI, Express API, and pglite)
RUN npm ci --omit=dev --workspace=@ai-office-suite/workers --no-audit --no-fund

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4200

COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.base.json ./
COPY packages ./packages
COPY platform/audit ./platform/audit
COPY platform/authorization ./platform/authorization
COPY engines/calculation ./engines/calculation
COPY engines/data-processing ./engines/data-processing
COPY engines/document ./engines/document
COPY engines/file-conversion ./engines/file-conversion
COPY engines/presentation ./engines/presentation
COPY apps/workers ./apps/workers

USER node
EXPOSE 4200

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const port = process.env.PORT || 4200; fetch('http://127.0.0.1:' + port + '/health', { signal: AbortSignal.timeout(4000) }).then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "apps/workers/src/workerServer.ts"]
