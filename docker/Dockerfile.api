# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS deps

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared-contracts/package.json packages/shared-contracts/
COPY packages/validation/package.json packages/validation/
COPY platform/audit/package.json platform/audit/
COPY platform/authorization/package.json platform/authorization/
COPY platform/database/package.json platform/database/
COPY platform/identity/package.json platform/identity/
COPY platform/storage/package.json platform/storage/
COPY engines/analytics/package.json engines/analytics/
COPY engines/calculation/package.json engines/calculation/
COPY engines/data-processing/package.json engines/data-processing/
COPY engines/document/package.json engines/document/
COPY engines/file-conversion/package.json engines/file-conversion/
COPY engines/integration/package.json engines/integration/
COPY engines/intelligence/package.json engines/intelligence/
COPY engines/presentation/package.json engines/presentation/
COPY engines/speech/package.json engines/speech/
COPY modules/ai/package.json modules/ai/
COPY modules/documents/package.json modules/documents/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/

RUN npm ci --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4100

COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.base.json ./
COPY packages ./packages
COPY platform ./platform
COPY engines ./engines
COPY modules ./modules
COPY apps/api ./apps/api
COPY scripts/db-cli.mjs ./scripts/db-cli.mjs

USER node
EXPOSE 4100

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4100/api/ready').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "apps/api/src/server.ts"]
