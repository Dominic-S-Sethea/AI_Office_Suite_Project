# AI Office Suite — Phase D0/D1 Local Prototype Environment Configuration
# Copy to .env for local development. Never commit real credentials.

NODE_ENV=development
PORT=4100
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Storage (local prototype filesystem store; ignored by git)
LOCAL_STORAGE_DIR=.local-data

# Headless Chromium / Edge binary for searchable PDF rendering with HarfBuzz Khmer shaping
# Leave unset for automatic local detection (Edge/Chrome on Windows, Chromium on Linux)
CHROMIUM_PATH=

# Speech Recognition Provider Adapter (D1 default: mock)
# Supported values: mock | google-cloud-stt-v2 | azure-speech | faster-whisper
SPEECH_PROVIDER=mock
ALLOW_LIVE_SPEECH_PROVIDERS=false

# AI Document Planner Adapter (D1 default: mock deterministic bilingual planner)
AI_PLANNER_PROVIDER=mock
ALLOW_LIVE_AI_PROVIDERS=false
