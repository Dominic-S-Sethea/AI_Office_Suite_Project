# AI Office Suite — Environment Configuration Template
# Copy to .env for local or Docker Compose deployment. NEVER commit real secrets or .env.

NODE_ENV=development
PORT=4100
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Reverse proxy hops trusted by Express (false, 0..5, loopback, linklocal, uniquelocal)
TRUST_PROXY=false

# Authentication Mode:
#   provisional-local — Phase D1 loopback-only local prototype (refuses production / non-loopback)
#   jwt-pg            — Phase D2 PostgreSQL RLS + HttpOnly aios_session cookie + HS256 JWT
AUTH_MODE=provisional-local

# PostgreSQL 16 connection (required when AUTH_MODE=jwt-pg)
# Use the non-superuser runtime role (`aios_app`) in production so FORCE ROW LEVEL SECURITY applies.
# Example: postgres://aios_app:<strong-password>@127.0.0.1:5432/aios_suite
DATABASE_URL=
REQUIRE_NON_SUPERUSER_DB=false
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000
# TLS mode: disable | require | verify-full (use verify-full + PG_SSL_CA_FILE in production)
PG_SSL_MODE=
PG_SSL_CA_FILE=
AUTO_MIGRATE_ON_START=false

# Cryptographic Secrets (required in production / jwt-pg; >=32 random bytes; never use placeholders)
JWT_SECRET=
PII_PSEUDONYMIZATION_KEY=
AI_PROPOSAL_SIGNING_SECRET=

# Docker Compose PostgreSQL settings (used by docker-compose.yml)
# Superuser for one-shot `migrate` service:
POSTGRES_USER=aios_admin
POSTGRES_PASSWORD=
POSTGRES_DB=aios_suite
# Least-privilege NOBYPASSRLS runtime login role provisioned by `migrate` and used by `api`:
POSTGRES_APP_USER=aios_app
POSTGRES_APP_PASSWORD=
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080

# Explicit password (>=12 chars) required ONLY for non-production `npm run db:seed-dev`
DEV_SEED_PASSWORD=

# API Rate Limiting & Concurrency Protection
DISABLE_RATE_LIMIT=false
# Rate limit store: memory | postgres (defaults to postgres when NODE_ENV=production and AUTH_MODE=jwt-pg)
RATE_LIMIT_STORE=memory
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_LOGIN_IP_MAX=60
RATE_LIMIT_API_MAX=300
MAX_CONCURRENT_PDF_EXPORTS=2
MAX_CONCURRENT_DATA_PREP=2
READY_CACHE_TTL_MS=2000

# Isolated OOXML & Chromium Parser/Renderer Workers (@ai-office-suite/workers)
# Defaults to true in production; leave PARSER_WORKER_URL empty to spawn isolated local subprocesses
ISOLATED_PARSER_WORKERS=false
PARSER_WORKER_URL=
WORKER_TIMEOUT_MS=30000
WORKER_MAX_OLD_SPACE_MB=256

# Storage (local prototype filesystem store; ignored by git)
LOCAL_STORAGE_DIR=.local-data

# Headless Chromium / Edge binary for searchable PDF rendering with HarfBuzz Khmer shaping
# Leave unset for automatic local detection (Edge/Chrome on Windows, Chromium/Chrome on Linux)
CHROMIUM_PATH=
# Set to true only in CI/container environments lacking kernel user namespaces (defaults to sandboxed Chromium)
CHROMIUM_NO_SANDBOX=false

# Speech Recognition Gate Boundary (cloud STT / local faster-whisper adapters fail closed HTTP 423 unless explicitly enabled)
ALLOW_LIVE_SPEECH_PROVIDERS=false
ALLOW_LOCAL_FASTER_WHISPER=false
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_PYTHON=

# AI Provider Gate Boundary (live external LLM adapters remain blocked unless explicitly enabled)
ALLOW_LIVE_AI_PROVIDERS=false
