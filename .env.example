# AI Office Suite — Environment Configuration Template
# Copy to .env for local or Docker Compose deployment. NEVER commit real secrets or .env.

NODE_ENV=development
PORT=4100
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Authentication Mode:
#   provisional-local — Phase D1 loopback-only local prototype (refuses production / non-loopback)
#   jwt-pg            — Phase D2 PostgreSQL RLS + HttpOnly aios_session cookie + HS256 JWT
AUTH_MODE=provisional-local

# PostgreSQL 16 connection (required when AUTH_MODE=jwt-pg)
# Example: postgres://aios:<strong-password>@127.0.0.1:5432/aios_suite
DATABASE_URL=
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000
PG_SSL_MODE=
AUTO_MIGRATE_ON_START=false

# Required when AUTH_MODE=jwt-pg (>=32 cryptographically random characters; never use placeholders in production)
JWT_SECRET=

# Docker Compose PostgreSQL settings (used by docker-compose.yml)
POSTGRES_USER=aios
POSTGRES_PASSWORD=
POSTGRES_DB=aios_suite
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_API_MAX=300

# Storage (local prototype filesystem store; ignored by git)
LOCAL_STORAGE_DIR=.local-data

# Headless Chromium / Edge binary for searchable PDF rendering with HarfBuzz Khmer shaping
# Leave unset for automatic local detection (Edge/Chrome on Windows, Chromium/Chrome on Linux)
CHROMIUM_PATH=

# Speech Recognition Provider Adapter (default: mock, isMock: true; live cloud adapters fail closed 423)
SPEECH_PROVIDER=mock
ALLOW_LIVE_SPEECH_PROVIDERS=false

# AI Document Planner Adapter (default: deterministic local bilingual planner)
AI_PLANNER_PROVIDER=mock
ALLOW_LIVE_AI_PROVIDERS=false
